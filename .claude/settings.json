{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run check:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run smoke)",
      "Bash(npm run smoke:*)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx biome:*)",
      "Bash(cp -r projects/:*)",
      "Bash(mkdir -p projects/:*)",
      "Bash(mkdir -p public/:*)",
      "WebFetch(domain:threejs.org)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:rapier.rs)",
      "WebFetch(domain:developer.mozilla.org)"
    ],
    "deny": [
      "Bash(npm run dev:*)",
      "Bash(npm run preview:*)",
      "Bash(npx vite:*)",
      "Bash(vite:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(killall:*)",
      "Bash(npm run station:reset:*)",
      "Bash(node scripts/reset-station.ts:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git checkout:*)",
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Edit(projects/_vorlage-*/**)",
      "Write(projects/_vorlage-*/**)"
    ]
  }
}
